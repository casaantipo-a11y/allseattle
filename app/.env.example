# Copy to .env and fill in. Only the first three are required to run locally;
# everything else switches a feature on when set.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/allseattle
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ROOT_DOMAIN=
ENABLE_SUBDOMAINS=false

# Cloudflare R2 (S3-compatible). Empty = uploads go to ./media on local disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
# Sender for notification emails; until the site's domain is verified in Resend
# its test sender (onboarding@resend.dev) is used.
RESEND_FROM=
NOTIFY_EMAIL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe (stage 3: package subscriptions). Restricted or secret key (sk_test_… / rk_test_…)
# and the signing secret of the webhook endpoint /api/stripe/webhook (whsec_…).
# Empty = online payment off; the account pages say "contact us" instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Managed Payments (Stripe as merchant of record, handles US sales tax for a fee) is on by
# default for new accounts. "off" turns it off for our Checkouts; with it on, STRIPE_TAX_CODE
# must be an eligible product tax code (txcd_…). Empty = the account's default.
STRIPE_MANAGED_PAYMENTS=
STRIPE_TAX_CODE=
# Stripe Tax (the client's "Basic" plan): "on" adds sales tax on top of the price at Checkout
# from the buyer's address (the account needs Stripe Tax active and a state registration;
# Managed Payments off).
STRIPE_AUTOMATIC_TAX=
# A customer-portal configuration id (bpc_…) made for the site; empty = the Dashboard default.
STRIPE_PORTAL_CONFIGURATION=

# Any long random string. Vercel Cron sends it to /api/cron/daily (daily reminders: listings
# about to expire, hand-set packages about to end; then the automatic import of events and
# news drafts). Empty = the whole daily job is off.
CRON_SECRET=

# Ticketmaster Discovery API key (developer.ticketmaster.com, free). Only the Ticketmaster
# import source uses it; without it that source reports "TICKETMASTER_API_KEY is not set".
TICKETMASTER_API_KEY=

# Used by `pnpm seed` to create the first admin user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
