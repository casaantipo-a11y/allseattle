# Copy to .env and fill in. Only the first three are required to run locally;
# everything else switches a feature on when set.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/allseattle
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ROOT_DOMAIN=
ENABLE_SUBDOMAINS=false

# Cloudflare R2 (S3-compatible). Empty = uploads go to ./media on local disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
# Sender for notification emails; until the site's domain is verified in Resend
# its test sender (onboarding@resend.dev) is used.
RESEND_FROM=
NOTIFY_EMAIL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used by `pnpm seed` to create the first admin user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
